rules_version = '2';
// Karjian × Oh Thanksgiving: anyone with the link can read and sign up.
// Writes are limited to the expected shape and size.
service cloud.firestore {
  match /databases/{database}/documents {
    match /signups/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['activity', 'person', 'ts'])
        && request.resource.data.activity is string && request.resource.data.activity.size() <= 40
        && request.resource.data.person is string && request.resource.data.person.size() <= 30
        && id == request.resource.data.activity + '__' + request.resource.data.person;
      allow delete: if true;
    }
    match /wall/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'text', 'ts'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 280;
      allow delete: if true;
      allow update: if false;
    }
    match /games/{id} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
